{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryan-Clinton/telescopeyoke/schemas/onboard-record.schema.json",
  "title": "Onboard record",
  "description": "cache/onboard.json: the steps of a first setup the person has said they saw, each with when, and for equipment the settings it was given for.",
  "type": "object",
  "properties": {
    "confirmed": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "telescope",
          "camera",
          "equipment",
          "frame",
          "moves",
          "first-light",
          "motor-focuser",
          "manual-focuser"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "at"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "equipment": {
            "type": "object"
          },
          "settings": {
            "type": "object"
          },
          "light_path": {
            "type": "array"
          },
          "mount": {
            "type": "object",
            "description": "For moves: the mount the word was given for (onboard.mount_identity)."
          }
        }
      }
    }
  }
}
