{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryan-Clinton/telescopeyoke/schemas/night.schema.json",
  "title": "Night",
  "description": "data of: ty night --json",
  "type": "object",
  "required": [
    "site",
    "verdict",
    "darkness",
    "moon",
    "spot",
    "skyline_measured",
    "discovery",
    "best_now"
  ],
  "properties": {
    "site": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "GO",
        "MARGINAL",
        "NO-GO",
        null
      ]
    },
    "clear_hours": {
      "type": [
        "integer",
        "null"
      ]
    },
    "darkness": {
      "type": "object"
    },
    "moon": {
      "type": "object"
    },
    "spot": {"type": ["string", "null"], "description": "Where in the garden the telescope stands (ty spot); null when none is named, and in the demo."},
    "skyline_measured": {"type": "boolean", "description": "Whether a measured skyline is in use for this spot; false means the windows go by the lowest altitude alone."},
    "discovery": {
      "description": "The discovery programmes (programmes/*.toml), the night's first purpose: each field's window in darkness above the horizon limits and measured skyline, best first; window null when it is not up in darkness.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["programme", "field", "minutes", "mosaic", "command", "window", "best_time", "best_altitude_deg", "direction"],
        "properties": {
          "programme": {"type": "string"},
          "field": {"type": "string"},
          "minutes": {"type": ["number", "null"], "description": "For a mosaic, minutes on each panel."},
          "mosaic": {"type": "boolean"},
          "command": {"type": ["string", "null"]},
          "window": {"type": ["array", "null"]},
          "best_time": {},
          "best_altitude_deg": {"type": ["number", "null"]},
          "direction": {"type": ["string", "null"]}
        }
      }
    },
    "best_now": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
