{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryan-Clinton/telescopeyoke/schemas/targets.schema.json",
  "title": "Targets",
  "description": "The best targets tonight, best first (ty targets).",
  "type": "object",
  "required": [
    "count",
    "targets"
  ],
  "properties": {
    "count": {
      "type": "integer"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "score",
          "observable_now"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "observable_now": {
            "type": "boolean"
          },
          "direction": {
            "type": "string"
          },
          "best_altitude_deg": {
            "type": "number"
          },
          "tags": {
            "type": "array"
          },
          "rating": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 5,
            "description": "Gary Imm's rating in his Deep Sky Compendium, 0 (low) to 5 (high); null when he has none or the Compendium has not been fetched (compendium.py)."
          },
          "note": {
            "type": "string",
            "description": "Gary Imm's note on the object from his Compendium; empty when there is none."
          },
          "palette": {
            "type": [
              "object",
              "null"
            ],
            "description": "The palette Gary Imm's Compendium gives for this kind of object, as the wheel's filters; null when he gives none (galaxies, clusters) or the Compendium has not been fetched. His, not the planner's.",
            "required": [
              "name",
              "filters",
              "light",
              "source"
            ],
            "properties": {
              "name": {
                "enum": [
                  "SHO",
                  "HOO",
                  "Ha+RGB",
                  "LRGB"
                ]
              },
              "filters": {
                "type": "array",
                "items": {
                  "enum": [
                    "L",
                    "R",
                    "G",
                    "B",
                    "Ha",
                    "SII",
                    "OIII"
                  ]
                }
              },
              "light": {
                "type": "string",
                "description": "What his class says of its light, e.g. SII .2, Ha 1, OIII .1 (strongest 1), or OIII strongest."
              },
              "source": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
