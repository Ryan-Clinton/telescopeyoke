{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryan-Clinton/telescopeyoke/schemas/transits.schema.json",
  "title": "Transits",
  "description": "data of: transits.py [tonight] --json, the known exoplanet transits that can be taken whole in the dark here tonight, deepest first; and of transits.py measure SESSION --planet NAME --json, the star's light curve from the night's frames with the fitted depth and timing against the prediction. Nothing moves.",
  "type": "object",
  "anyOf": [
    {"required": ["night", "deeper", "planets", "bright_and_deep", "transits", "kind"]},
    {"required": ["planet", "star", "session", "predicted_middle", "expected_depth", "hours", "fit", "jd", "mag", "kind"]}
  ],
  "properties": {
    "night": {"type": "string"},
    "deeper": {"type": "number", "description": "Percent: the shallowest transit listed."},
    "planets": {"type": "integer"},
    "bright_and_deep": {"type": "integer"},
    "transits": {"type": "array", "items": {"type": "object",
      "required": ["planet", "star", "ra", "dec", "v", "depth", "hours", "middle", "start", "mid", "end", "altitude"],
      "properties": {"planet": {"type": "string"}, "star": {"type": "string"}, "ra": {"type": "number"},
                     "dec": {"type": "number"}, "v": {"type": "number"}, "depth": {"type": "number", "description": "Percent."},
                     "hours": {"type": "number"}, "middle": {"type": "number", "description": "JD of the transit's middle."},
                     "start": {"type": "string", "description": "Local time, BASELINE minutes before the transit."},
                     "mid": {"type": "string"}, "end": {"type": "string"}, "altitude": {"type": "number"},
                     "exposure": {"type": "number", "description": "Seconds a frame: 4 for a star bright enough to fill the wells in 16."}}}},
    "planet": {"type": "string"},
    "star": {"type": "string"},
    "session": {"type": "string"},
    "predicted_middle": {"type": ["number", "null"]},
    "expected_depth": {"type": "number"},
    "hours": {"type": "number"},
    "fit": {"type": ["object", "null"], "properties": {
      "depth": {"type": "number"}, "depth_error": {"type": "number"}, "middle": {"type": "number"},
      "early_late_min": {"type": "number"}, "scatter_mmag": {"type": "number"},
      "in_transit_points": {"type": "integer"}, "out_of_transit_points": {"type": "integer"}}},
    "jd": {"type": "array", "items": {"type": "number"}},
    "mag": {"type": "array", "items": {"type": ["number", "null"]}},
    "kind": {"enum": ["inferred", "measured"]}
  }
}
