{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryan-Clinton/telescopeyoke/schemas/report.schema.json",
  "title": "Report",
  "description": "data of: report.py CANDIDATE --json. Everything a report of a new transient needs, gathered from what is on file for a person to check and send: never sent by the software. Also kept as reports/ID/report.json with report.txt and finding.png.",
  "type": "object",
  "required": ["id", "object", "ra", "dec", "ra_hms", "dec_dms", "position_error_arcsec", "discovered_utc", "night",
               "mag", "mag_error", "band", "limit_5sigma", "nights_seen", "nights_measured", "reference",
               "last_non_detection", "checks", "kinds", "not_yet"],
  "properties": {
    "id": {"type": "string"},
    "object": {"type": "string"},
    "ra": {"type": "number"},
    "dec": {"type": "number"},
    "ra_hms": {"type": "string"},
    "dec_dms": {"type": "string"},
    "position_error_arcsec": {"type": "number"},
    "discovered_utc": {"type": ["string", "null"], "description": "The middle of the night's kept frames."},
    "night": {"type": "string"},
    "mag": {"type": ["number", "null"]},
    "mag_error": {"type": ["number", "null"]},
    "band": {"type": "string"},
    "limit_5sigma": {"type": ["number", "null"]},
    "nights_seen": {"type": "integer"},
    "nights_measured": {"type": "integer"},
    "reference": {"type": ["string", "null"]},
    "science": {"type": ["string", "null"]},
    "difference": {"type": ["string", "null"]},
    "last_non_detection": {"type": ["object", "null"], "properties": {"night": {"type": "string"}, "limit": {"type": "number"}}},
    "checks": {"type": "object"},
    "verdict": {"type": ["string", "null"]},
    "kinds": {"type": "object", "additionalProperties": {"enum": ["measured", "inferred", "estimated", "simulated", "reported", "not known"]}},
    "not_yet": {"type": "array", "items": {"type": "string"}, "description": "What a report would still want before it is sent."},
    "finding_chart": {"type": "string"},
    "seconds": {"type": "number", "description": "How long gathering it took; the target is under 300."}
  }
}
