{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py\" all",
            "onFailure": "block",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Skill|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/log.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/log.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sky.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/log.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
