#!/usr/bin/env python3
"""One way in to telescopeyoke, for people and for programs.

    ./ty capabilities        what can be done right now, and what is missing
    ./ty status              mount, camera, imaging and solver states
    ./ty context             a short briefing in plain words
    ./ty doctor              the full system check
    ./ty night               tonight in brief
    ./ty targets --limit 5   the best targets (--now, --kind galaxy)
    ./ty target M27          one object: where it is, whether a GoTo is allowed
    ./ty session             the newest imaging run (--frames 50 for detail)
    ./ty observing           sky, focus, tracking and imaging in one snapshot
    ./ty run stop            tell the imaging run that is going to finish now and make its
                             picture (also: recentre, assist-on, assist-off)
    ./ty mount ...           everything mount.py does, e.g. ./ty mount goto M27 --dry-run
    ./ty tonight ...         the full report, as tonight.py

Add --json to any of them for a machine-readable answer in one fixed shape
(see schemas/ and docs/agents/). Add --demo to try it with no telescope.
Nothing here moves the mount except "ty mount" commands that say they do.
"""
import argparse
import json
import sys

PASS_THROUGH = {"mount": "mount", "tonight": "tonight", "shoot": "shoot", "focus": "focus",
                "solve": "solve", "restack": "restack"}


def show(value, indent=0):
    """Plain-text rendering of an answer, for people."""
    pad = "  " * indent
    if isinstance(value, dict):
        for key, item in value.items():
            if isinstance(item, (dict, list)) and item:
                print(f"{pad}{key}:")
                show(item, indent + 1)
            else:
                print(f"{pad}{key}: {item if item not in (None, [], {}) else '-'}")
    elif isinstance(value, list):
        for item in value:
            if isinstance(item, dict):
                print(pad + ", ".join(f"{k} {v}" for k, v in item.items()
                                      if not isinstance(v, (dict, list))))
            else:
                print(f"{pad}{item}")
    else:
        print(f"{pad}{value}")


def main():
    if len(sys.argv) > 1 and sys.argv[1] in PASS_THROUGH:
        # The individual scripts keep their own options; this just finds them.
        import importlib
        module = importlib.import_module(PASS_THROUGH[sys.argv[1]])
        sys.argv = [f"ty {sys.argv[1]}"] + sys.argv[2:]
        module.main()
        return 0

    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", choices=["capabilities", "status", "context", "doctor", "night",
                                        "targets", "target", "session", "observing", "run"])
    ap.add_argument("name", nargs="?", help="object name, for 'target'; the order, for 'run'")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--demo", action="store_true", help="made-up weather at the example site")
    ap.add_argument("--limit", type=int, default=10)
    ap.add_argument("--kind", help="for targets: galaxy, planet, globular ...")
    ap.add_argument("--now", action="store_true", help="for targets: only those up now")
    ap.add_argument("--frames", type=int, default=0, help="for session: include the last N frames")
    args = ap.parse_args()

    import agent
    import doctor
    import interface

    if args.command == "context" and not args.json:
        print(agent.context(args.demo))
        return 0
    if args.command == "target" and not args.name:
        ap.error("target needs a name, e.g. ty target M27")
    work = {
        "capabilities": agent.capabilities,
        "status": agent.status,
        "context": lambda: {"text": agent.context(args.demo)},
        "doctor": lambda: doctor.report(skip_handset=True),
        "night": lambda: agent.night(args.demo),
        "targets": lambda: agent.targets(args.limit, args.kind, args.now, args.demo),
        "target": lambda: agent.target(args.name, args.demo),
        "session": lambda: agent.session(bool(args.frames), args.frames or 50),
        "observing": lambda: agent.observing(args.demo),
        "run": lambda: __import__("shoot").tell(args.name or ""),
    }[args.command]
    result = interface.run(args.command, work)
    if args.json:
        return interface.emit(result)
    if not result["ok"]:
        print(result["errors"][0]["message"], file=sys.stderr)
        return 1
    show(json.loads(json.dumps(result["data"], default=interface.jsonable)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
